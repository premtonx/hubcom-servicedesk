# GeistDesk turnkey reverse proxy.
# DOMAIN comes from the compose environment (install.sh / .env).
# localhost & raw IPs → HTTP (Caddy skips public ACME).
# Real DNS hostnames → automatic Let's Encrypt on :443.

{$DOMAIN:localhost} {
	encode gzip zstd

	# Upstream keepalive idle (30s) must stay strictly below Node's
	# keepAliveTimeout (65s) so Caddy retires sockets before the backend
	# closes them — otherwise POST /api/db hits intermittent 502s.
	# Read/write timeouts stay generous for slow RLS / get_docs work.
	handle /api/* {
		reverse_proxy backend:5000 {
			transport http {
				versions 1.1
				keepalive 30s
				keepalive_idle_conns 32
				response_header_timeout 120s
				read_timeout 120s
				write_timeout 120s
				dial_timeout 10s
			}
		}
	}

	handle {
		reverse_proxy frontend:80
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	log {
		output stdout
		format console
	}
}
