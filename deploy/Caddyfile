# GeistDesk turnkey reverse proxy.
# DOMAIN comes from the compose environment (install.sh / .env).
# localhost & raw IPs → HTTP (Caddy skips public ACME).
# Real DNS hostnames → automatic Let's Encrypt on :443.

{$DOMAIN:localhost} {
	encode gzip zstd

	# Concurrent POST /api/db polls (onSnapshot / subscribeToCustomers) need
	# generous read timeouts + HTTP/1.1 keepalive so slow DB/RLS work never
	# surfaces as 502 Bad Gateway at the edge.
	handle /api/* {
		reverse_proxy backend:5000 {
			transport http {
				versions 1.1
				keepalive 30s
				keepalive_idle_conns 32
				response_header_timeout 120s
				read_timeout 120s
				write_timeout 120s
				dial_timeout 10s
			}
		}
	}

	handle {
		reverse_proxy frontend:80
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	log {
		output stdout
		format console
	}
}
