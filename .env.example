# ==============================================================================
# GeistDesk — Environment Template (.env.example)
# Copy to .env or run ./setup.sh to auto-fill secrets.
# ==============================================================================

# Enable Traefik integration by default if running with Traefik:
# COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml

# -----------------------------------------------------------------------------
# Public URL / Reverse Proxy
# -----------------------------------------------------------------------------
DOMAIN=localhost
DOMAIN_NAME=localhost
PUBLIC_APP_URL=http://localhost:5000
PUBLIC_HOSTNAME=localhost
INBOUND_EMAIL_DOMAIN=inbound.localhost
ROUTER_NAME=geistdesk
TRAEFIK_NETWORK=traefik-public
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=myresolver
HOST_PORT=127.0.0.1:5000
# Trust proxy headers for client IP (rate limits / IP bans). Set 1 behind Traefik/Nginx.
TRUST_PROXY=1
# Comma-separated trusted admin/office IPs that never receive automatic IP bans.
# ADMIN_IP_ALLOWLIST=203.0.113.10,198.51.100.20
ADMIN_IP_ALLOWLIST=

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# -----------------------------------------------------------------------------
# PostgreSQL (pgvector)
# -----------------------------------------------------------------------------
POSTGRES_USER=geist_user
POSTGRES_PASSWORD=replace_with_db_password
POSTGRES_DB=geistdesk_prod
GEISTDESK_DATABASE_URL=postgresql://geist_user:replace_with_db_password@geistdesk-db:5432/geistdesk_prod?sslmode=disable
# Optional runtime URL as hubcom_app (NOBYPASSRLS). Leave empty to use GEISTDESK_DATABASE_URL.
# DATABASE_APP_URL=postgresql://hubcom_app:replace_with_app_password@geistdesk-db:5432/geistdesk_prod?sslmode=disable
DATABASE_APP_URL=
DATABASE_SSL_INSECURE=false

# -----------------------------------------------------------------------------
# Core Encryption & Secrets (openssl rand -hex <bytes>)
# -----------------------------------------------------------------------------
JWT_SECRET=replace_with_openssl_rand_hex_48
VAULT_ENCRYPTION_KEY=replace_with_openssl_rand_hex_32
# Prefer a dedicated key for M365 channel client_secret encryption; falls back to VAULT_ENCRYPTION_KEY.
EMAIL_CHANNEL_SECRET_KEY=replace_with_openssl_rand_hex_32
AI_SECRETS_KEY=replace_with_openssl_rand_hex_32
MASTER_KEY_SALT=replace_with_openssl_rand_hex_24
VITE_MASTER_KEY_SALT=replace_with_openssl_rand_hex_24
INBOUND_MAIL_WEBHOOK_SECRET=replace_with_openssl_rand_hex_32

# -----------------------------------------------------------------------------
# Inbound Mail / Outbound SMTP
# -----------------------------------------------------------------------------
INBOUND_MAIL_FORWARD_DOMAIN=inbound.localhost
EMAIL_INGESTION_INTERVAL_MS=60000
SMTP_HOST=
SMTP_USER=
SMTP_FROM=
RESEND_API_KEY=
MAIL_DISPATCH_URL=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Hubcom ServiceDesk Support
DOCUMENT_STORAGE_DIR=/app/storage/documents
KB_SOURCES_ROOT=/data/sources

# -----------------------------------------------------------------------------
# AI Providers (Configurable via UI or here)
# -----------------------------------------------------------------------------
OLLAMA_ENDPOINT=
VITE_OLLAMA_ENDPOINT=
OLLAMA_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-06-01
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
VECTOR_BACKFILL_BATCH=25

# -----------------------------------------------------------------------------
# SSO / Microsoft Entra / OIDC (Optional)
# -----------------------------------------------------------------------------
MICROSOFT_PROVIDER_CLIENT_ID=
MICROSOFT_PROVIDER_CLIENT_SECRET=
MICROSOFT_PROVIDER_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_TENANT_ID=

# -----------------------------------------------------------------------------
# Microsoft Graph / Teams Bot (Optional)
# -----------------------------------------------------------------------------
GRAPH_CLIENT_STATE_SECRET=
MicrosoftAppId=
MicrosoftAppPassword=
MicrosoftAppType=
MicrosoftAppTenantId=

# -----------------------------------------------------------------------------
# Hardening
# -----------------------------------------------------------------------------
BETA_AUTO_ADMIN=false
VITE_BETA_AUTO_ADMIN=false
ENABLE_DEMO_LOGIN=false
VITE_ENABLE_DEMO_LOGIN=false
VITE_DEMO_MODE=false
ALLOW_PUBLIC_REGISTRATION=false
ENABLE_SANDBOX=false
